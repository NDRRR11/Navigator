<?xml version="1.0" encoding="UTF-8"?>
<Module>
  <ModulePrefs
    title="Restricted Web Navigator Controller"
    description="Overlay controls for a Revel Digital Web Page zone. Uses the Revel Digital callback bridge to control the Android Web Page zone."
    author="Custom Gadget"
    background="transparent">
    <UserPref name="homeUrl" display_name="Home URL" datatype="string" default_value="" required="true" />
    <UserPref name="buttonText" display_name="Button Text" datatype="string" default_value="Back|Home" required="true" />
    <UserPref name="ForeColor" datatype="hidden" />
    <UserPref name="BackColor" datatype="hidden" />
    <UserPref name="rdW" display_name="Width" required="true" default_value="300" datatype="hidden" />
    <UserPref name="rdH" display_name="Height" required="true" default_value="90" datatype="hidden" />
    <UserPref name="rdKey" display_name="Device Registration Key" default_value="*|DEVICE.REGISTRATIONKEY|*" datatype="hidden" />
  </ModulePrefs>
  <Content type="html"><![CDATA[
    <style>
      html,body{margin:0;padding:0;width:100%;height:100%;overflow:hidden;background:transparent}
      #nav{width:100%;height:100%;display:flex;align-items:center;gap:8px;box-sizing:border-box;padding:8px}
      button{flex:1;height:100%;min-width:0;border:1px solid rgba(255,255,255,.35);border-radius:8px;background:rgba(20,20,20,.88);color:#fff;font:600 22px Arial,sans-serif}
      button:active{background:rgba(70,70,70,.95)}
    </style>
    <div id="nav">
      <button id="back">Back</button>
      <button id="home">Home</button>
    </div>
    <script type="module">
      import { createPlayerClient } from "https://unpkg.com/@reveldigital/client-sdk@latest/dist/index.js";

      const prefs = new gadgets.Prefs();
      const homeUrl = prefs.getString("homeUrl") || "";
      const client = createPlayerClient();

      document.getElementById("back").addEventListener("click", () => {
        client.callback("navigator.back");
      });

      document.getElementById("home").addEventListener("click", () => {
        client.callback("navigator.home|" + homeUrl);
      });
    </script>
  ]]></Content>
</Module>
