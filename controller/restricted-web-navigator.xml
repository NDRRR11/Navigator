<Module>
  <ModulePrefs
      title="Restricted Web Navigator Controller"
      description="Back and Home controls for a Revel Digital Web Page."
      author="Custom Gadget"
      background="transparent">

    <UserPref
        name="homeUrl"
        display_name="Home URL"
        datatype="string"
        default_value=""
        required="true"/>

    <UserPref
        name="buttonText"
        display_name="Button Text"
        datatype="string"
        default_value="Back|Home"
        required="true"/>

    <UserPref name="ForeColor" datatype="hidden"/>
    <UserPref name="BackColor" datatype="hidden"/>

    <UserPref
        name="rdW"
        display_name="Width"
        required="true"
        default_value="300"
        datatype="hidden"/>

    <UserPref
        name="rdH"
        display_name="Height"
        required="true"
        default_value="90"
        datatype="hidden"/>

    <UserPref
        name="rdKey"
        display_name="Device Registration Key"
        default_value="*|DEVICE.REGISTRATIONKEY|*"
        datatype="hidden"/>

  </ModulePrefs>

  <Content type="html">
  <![CDATA[

  <style>
    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: transparent;
    }

    #nav {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      gap: 8px;
      box-sizing: border-box;
      padding: 8px;
    }

    button {
      flex: 1;
      height: 100%;
      min-width: 0;
      border: 1px solid rgba(255,255,255,.35);
      border-radius: 8px;
      background: rgba(20,20,20,.88);
      color: #fff;
      font: 600 22px Arial, sans-serif;
    }

    button:active {
      background: rgba(70,70,70,.95);
    }
  </style>

  <div id="nav">
    <button id="back">Back</button>
    <button id="home">Home</button>
  </div>

  <script type="text/javascript">

    var prefs = new gadgets.Prefs();

    function onLoad() {

      var back = document.getElementById("back");
      var home = document.getElementById("home");

      back.onclick = function() {

        if (window.Client &&
            typeof window.Client.sendCommand === "function") {

          back.innerHTML = "SENDING...";

          window.Client.sendCommand(
            "navigator.back",
            ""
          );

          window.setTimeout(function() {
            back.innerHTML = "Back";
          }, 1000);

        } else {

          back.innerHTML = "NO BRIDGE";

          window.setTimeout(function() {
            back.innerHTML = "Back";
          }, 2000);
        }
      };

      home.onclick = function() {

        var homeUrl = prefs.getString("homeUrl");

        if (window.Client &&
            typeof window.Client.sendCommand === "function") {

          home.innerHTML = "SENDING...";

          window.Client.sendCommand(
            "navigator.home",
            homeUrl
          );

          window.setTimeout(function() {
            home.innerHTML = "Home";
          }, 1000);

        } else {

          home.innerHTML = "NO BRIDGE";

          window.setTimeout(function() {
            home.innerHTML = "Home";
          }, 2000);
        }
      };
    }

    gadgets.util.registerOnLoadHandler(onLoad);

  </script>

  ]]>
  </Content>
</Module>
