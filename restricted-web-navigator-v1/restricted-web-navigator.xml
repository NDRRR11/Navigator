<?xml version="1.0" encoding="UTF-8"?>
<Module>
  <ModulePrefs
    title="Restricted Web Navigator"
    description="A configurable web navigator with Back and Home controls."
    author="Custom Gadget"
    background="transparent">

    <UserPref
      name="homeUrl"
      display_name="Home URL"
      datatype="string"
      default_value="https://ro.eprops.hhs.nd.gov/fs/4hBg/78d0fb6f"
      required="true" />

    <!-- The following preferences should not be modified -->
    <UserPref name="ForeColor" datatype="hidden" />
    <UserPref name="BackColor" datatype="hidden" />
    <UserPref name="rdW" display_name="Width" required="true" default_value="280" datatype="hidden" />
    <UserPref name="rdH" display_name="Height" required="true" default_value="190" datatype="hidden" />
    <UserPref name="rdKey" display_name="Device Registration Key" default_value="*|DEVICE.REGISTRATIONKEY|*" datatype="hidden" />
  </ModulePrefs>

  <Content type="html">
  <![CDATA[
  <style type="text/css">
    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: transparent;
    }

    body {
      width: __UP_rdW__px;
      height: __UP_rdH__px;
      font-family: Arial, Helvetica, sans-serif;
    }

    #navigator {
      position: relative;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: #ffffff;
    }

    #toolbar {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 64px;
      z-index: 1000;
      display: flex;
      align-items: stretch;
      gap: 8px;
      padding: 8px;
      box-sizing: border-box;
      background: #20252b;
    }

    .navButton {
      border: 0;
      border-radius: 6px;
      padding: 0 24px;
      min-width: 120px;
      height: 48px;
      font-size: 22px;
      font-weight: 600;
      line-height: 48px;
      cursor: pointer;
      user-select: none;
      -webkit-user-select: none;
      touch-action: manipulation;
    }

    .navButton:disabled {
      opacity: 0.45;
      cursor: default;
    }

    #contentFrame {
      position: absolute;
      top: 64px;
      left: 0;
      right: 0;
      bottom: 0;
      width: 100%;
      height: calc(100% - 64px);
      border: 0;
      margin: 0;
      padding: 0;
      background: #ffffff;
    }

    #loading {
      display: none;
      position: absolute;
      z-index: 1100;
      top: 64px;
      left: 0;
      right: 0;
      bottom: 0;
      align-items: center;
      justify-content: center;
      background: rgba(255,255,255,0.82);
      font-size: 24px;
      font-weight: 600;
    }

    #error {
      display: none;
      position: absolute;
      z-index: 1200;
      top: 64px;
      left: 0;
      right: 0;
      bottom: 0;
      padding: 32px;
      box-sizing: border-box;
      background: #ffffff;
      color: #222222;
      font-size: 22px;
      line-height: 1.4;
    }
  </style>

  <div id="navigator">
    <div id="toolbar">
      <button id="backButton" class="navButton" type="button" disabled="disabled">&#8592; Back</button>
      <button id="homeButton" class="navButton" type="button">Home</button>
    </div>

    <iframe
      id="contentFrame"
      title="Web Content"
      frameborder="0"
      scrolling="auto"
      referrerpolicy="strict-origin-when-cross-origin">
    </iframe>

    <div id="loading">Loading...</div>

    <div id="error">
      <strong>Unable to display this page inside the gadget.</strong>
      <br><br>
      The destination may prohibit being displayed inside an embedded window.
      If this occurs for a site you need to use, we can evaluate an alternate
      implementation for that site.
    </div>
  </div>

  <script type="text/javascript">
    (function () {
      var prefs = new gadgets.Prefs();

      var frame;
      var backButton;
      var homeButton;
      var loading;
      var errorPanel;

      var homeUrl = "";
      var navigationDepth = 0;
      var loadingHome = false;

      function trim(value) {
        return (value || "").replace(/^\s+|\s+$/g, "");
      }

      function validUrl(value) {
        return /^https?:\/\//i.test(value);
      }

      function updateBackButton() {
        backButton.disabled = navigationDepth <= 0;
      }

      function showLoading() {
        loading.style.display = "flex";
        errorPanel.style.display = "none";
      }

      function hideLoading() {
        loading.style.display = "none";
      }

      function showError() {
        loading.style.display = "none";
        errorPanel.style.display = "block";
      }

      function loadHome() {
        navigationDepth = 0;
        loadingHome = true;
        updateBackButton();
        showLoading();
        frame.src = homeUrl;
      }

      function goBack() {
        /*
         * Important limitation:
         * The gadget cannot directly inspect or control the navigation
         * history of a cross-origin iframe. We therefore use a controlled
         * navigation model where the browser history is only relied upon
         * when the embedded document permits it.
         *
         * The first V1 implementation deliberately avoids attempting to
         * inject scripts into ReadyOp or other cross-origin pages.
         */
        try {
          if (navigationDepth > 0 && frame.contentWindow) {
            frame.contentWindow.history.back();
          }
        } catch (e) {
          /*
           * Cross-origin security may prevent access to iframe history.
           * Leave the page unchanged rather than opening it outside the
           * gadget.
           */
        }
      }

      function onFrameLoad() {
        hideLoading();

        if (loadingHome) {
          loadingHome = false;
          navigationDepth = 0;
          updateBackButton();
          return;
        }

        /*
         * A load event means the top-level document in the iframe changed.
         * We cannot read its URL when it is cross-origin, but we can use
         * the event to enable Back after the initial Home document.
         */
        if (navigationDepth === 0) {
          navigationDepth = 1;
          updateBackButton();
        }
      }

      function onFrameError() {
        showError();
      }

      function initialize() {
        frame = document.getElementById("contentFrame");
        backButton = document.getElementById("backButton");
        homeButton = document.getElementById("homeButton");
        loading = document.getElementById("loading");
        errorPanel = document.getElementById("error");

        homeUrl = trim(prefs.getString("homeUrl"));

        if (!validUrl(homeUrl)) {
          errorPanel.innerHTML =
            "<strong>Invalid Home URL.</strong><br><br>" +
            "The Home URL must begin with http:// or https://.";
          errorPanel.style.display = "block";
          return;
        }

        backButton.onclick = goBack;
        homeButton.onclick = loadHome;

        frame.onload = onFrameLoad;
        frame.onerror = onFrameError;

        loadHome();
      }

      gadgets.util.registerOnLoadHandler(initialize);
    })();
  </script>
  ]]>
  </Content>
</Module>
